          </mxGeometry>
        </mxCell>
        <mxCell id="c_outer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#161727;strokeColor=#252848;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="640" width="375" x="20" y="100" as="geometry" />
        </mxCell>
        <mxCell id="c_head" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontColor=#b8bcdc;fontSize=13;fontStyle=1;strokeColor=none;fillColor=none;" value="client.ts — CLI Client" vertex="1">
          <mxGeometry height="28" width="375" x="20" y="106" as="geometry" />
        </mxCell>
        <mxCell id="c_subdesc" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontColor=#5860a0;fontSize=10;strokeColor=none;fillColor=none;whiteSpace=wrap;" value="Spawns the MCP server as a child process over stdio. Connects to Claude or GPT for reasoning. Routes every LLM tool call through the MCP server and returns results." vertex="1">
          <mxGeometry height="44" width="359" x="28" y="136" as="geometry" />
        </mxCell>
        <mxCell id="c_repl" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f1020;strokeColor=#222440;fontSize=10;fontColor=#9098c8;align=left;verticalAlign=top;" value="&lt;b&gt;Interactive REPL&lt;/b&gt;&lt;br&gt;&lt;br&gt;You:  (any text)           regular chat + tool use&lt;br&gt;You:  /prompts             list all 4 MCP prompts&lt;br&gt;You:  /prompt name k=&amp;quot;v&amp;quot;   invoke prompt + chat&lt;br&gt;You:  /voice               enter voice loop mode&lt;br&gt;You:  exit                 quit the session" vertex="1">
          <mxGeometry height="110" width="355" x="30" y="184" as="geometry" />
        </mxCell>
        <mxCell id="c_voice" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f1020;strokeColor=#222440;fontSize=10;fontColor=#9098c8;align=left;verticalAlign=top;" value="&lt;b&gt;Voice Loop  (/voice)&lt;/b&gt;&lt;br&gt;&lt;br&gt;1.  Verify sox is installed  (which rec)&lt;br&gt;2.  Press ENTER  to start recording&lt;br&gt;3.  sox rec  captures mic  -&gt;  temp WAV file&lt;br&gt;4.  Press ENTER  to stop recording&lt;br&gt;5.  Calls  speech_to_text  tool with file path&lt;br&gt;6.  ElevenLabs STT returns transcript string&lt;br&gt;7.  Sends transcript to LLM + VOICE_SYSTEM&lt;br&gt;    (VOICE_SYSTEM forces LLM to call TTS)&lt;br&gt;8.  Parses  &amp;quot;Audio saved to: /path.mp3&amp;quot;&lt;br&gt;9.  Auto-plays MP3 via afplay / mpg123&lt;br&gt;10. Loop back to step 2" vertex="1">
          <mxGeometry height="195" width="355" x="30" y="302" as="geometry" />
        </mxCell>
        <mxCell id="c_pinvoke" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f1020;strokeColor=#222440;fontSize=10;fontColor=#9098c8;align=left;verticalAlign=top;" value="&lt;b&gt;Prompt Invocation  (/prompt)&lt;/b&gt;&lt;br&gt;&lt;br&gt;1.  Parse  name  and  key=&amp;quot;value&amp;quot;  arg pairs&lt;br&gt;2.  Call  mcpClient.getPrompt({ name, args })&lt;br&gt;3.  Receive  messages[]  from the MCP server&lt;br&gt;    (prompt callbacks run server-side on invoke)&lt;br&gt;4.  Inject messages into conversation history&lt;br&gt;5.  LLM generates first response, calls tools&lt;br&gt;6.  Auto-play any MP3 the LLM generates" vertex="1">
          <mxGeometry height="135" width="355" x="30" y="505" as="geometry" />
        </mxCell>
        <mxCell id="c_llmprovider" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d0e1e;strokeColor=#222440;fontSize=10;fontColor=#5058a0;align=center;verticalAlign=middle;" value="LLM_PROVIDER=anthropic  -&gt;  claude-sonnet-4-20250514&lt;br&gt;LLM_PROVIDER=openai     -&gt;  gpt-4o" vertex="1">
          <mxGeometry height="46" width="355" x="30" y="648" as="geometry" />
        </mxCell>
        <mxCell id="mcp_outer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12131e;strokeColor=#22244a;strokeWidth=1;" value="" vertex="1">
