        <mxCell id="pc_outer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0e1c12;strokeColor=#1e4030;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="270" width="1860" x="20" y="926" as="geometry" />
        </mxCell>
        <mxCell id="pc_title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontColor=#50a068;fontSize=13;fontStyle=1;strokeColor=none;fillColor=none;" value="Why This Is Prompt-Centric MCP" vertex="1">
          <mxGeometry height="26" width="500" x="30" y="932" as="geometry" />
        </mxCell>
        <mxCell id="pc1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#081208;strokeColor=#1e4030;fontSize=10;fontColor=#70a880;align=left;verticalAlign=top;" value="&lt;b&gt;All Three Primitives&lt;/b&gt;&lt;br&gt;&lt;br&gt;Most MCP servers expose only Tools.&lt;br&gt;This project uses all three primitives&lt;br&gt;as a cohesive system:&lt;br&gt;&lt;br&gt;Tools    =  what the agent CAN do&lt;br&gt;Prompts  =  how the agent THINKS&lt;br&gt;Resources  =  what the agent KNOWS&lt;br&gt;&lt;br&gt;Each primitive has a distinct role and&lt;br&gt;complements the others." vertex="1">
          <mxGeometry height="218" width="290" x="30" y="962" as="geometry" />
        </mxCell>
        <mxCell id="pc2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#081208;strokeColor=#1e4030;fontSize=10;fontColor=#70a880;align=left;verticalAlign=top;" value="&lt;b&gt;Dynamic Prompt Context&lt;/b&gt;&lt;br&gt;&lt;br&gt;Prompt callbacks run at invocation&lt;br&gt;time, not at server startup.&lt;br&gt;&lt;br&gt;voice_agent_persona fetches the live&lt;br&gt;ElevenLabs voice list and embeds it&lt;br&gt;directly in the instructions. The agent&lt;br&gt;identity is grounded in real-time API&lt;br&gt;data, not hardcoded strings. Change&lt;br&gt;your voices, the prompt adapts." vertex="1">
          <mxGeometry height="218" width="290" x="336" y="962" as="geometry" />
        </mxCell>
        <mxCell id="pc3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#081208;strokeColor=#1e4030;fontSize=10;fontColor=#70a880;align=left;verticalAlign=top;" value="&lt;b&gt;Session-Level Rules&lt;/b&gt;&lt;br&gt;&lt;br&gt;start_voice_session does not ask the&lt;br&gt;LLM to call one tool. It sets behavioral&lt;br&gt;rules for an entire conversation: always&lt;br&gt;speak via TTS, keep responses brief and&lt;br&gt;spoken-natural, lock to one voice.&lt;br&gt;&lt;br&gt;This is the difference between a&lt;br&gt;tool-calling chatbot and a coherent,&lt;br&gt;consistent voice agent." vertex="1">
          <mxGeometry height="218" width="290" x="642" y="962" as="geometry" />
        </mxCell>
        <mxCell id="pc4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#081208;strokeColor=#1e4030;fontSize=10;fontColor=#70a880;align=left;verticalAlign=top;" value="&lt;b&gt;Workflows as Prompts&lt;/b&gt;&lt;br&gt;&lt;br&gt;find_voice_for_role and voice_showcase&lt;br&gt;are multi-step workflows encoded as&lt;br&gt;prompts, not as hardcoded client logic.&lt;br&gt;&lt;br&gt;The LLM reads the instructions and&lt;br&gt;orchestrates the tool calls itself.&lt;br&gt;Adding a new workflow = one new prompt.&lt;br&gt;No changes to client.ts or index.ts&lt;br&gt;business logic needed." vertex="1">
          <mxGeometry height="218" width="290" x="948" y="962" as="geometry" />
        </mxCell>
        <mxCell id="pc5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#081208;strokeColor=#1e4030;fontSize=10;fontColor=#70a880;align=left;verticalAlign=top;" value="&lt;b&gt;LLM-Agnostic Server&lt;/b&gt;&lt;br&gt;&lt;br&gt;index.ts has zero knowledge of which&lt;br&gt;LLM the client is using. All three&lt;br&gt;primitives are defined once in MCP&lt;br&gt;format.&lt;br&gt;&lt;br&gt;client.ts translates to Anthropic&lt;br&gt;tool_use or OpenAI function calling.&lt;br&gt;The same server works with any&lt;br&gt;MCP-aware client without changes." vertex="1">
          <mxGeometry height="218" width="290" x="1254" y="962" as="geometry" />
        </mxCell>
        <mxCell id="pc6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#081208;strokeColor=#1e4030;fontSize=10;fontColor=#70a880;align=left;verticalAlign=top;" value="&lt;b&gt;Resources as Living Context&lt;/b&gt;&lt;br&gt;&lt;br&gt;elevenlabs://voices and&lt;br&gt;elevenlabs://models are fetched fresh&lt;br&gt;on every read request.&lt;br&gt;&lt;br&gt;MCP clients that support resource&lt;br&gt;subscriptions (Claude Desktop, Claude&lt;br&gt;Code) get automatic context refresh.&lt;br&gt;The agent always sees current voice&lt;br&gt;availability without a tool call." vertex="1">
          <mxGeometry height="218" width="305" x="1560" y="962" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
