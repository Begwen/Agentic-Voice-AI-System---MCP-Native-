        </mxCell>
        <mxCell id="mcp_head" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontColor=#a0a4c8;fontSize=12;fontStyle=1;strokeColor=none;fillColor=none;" value="index.ts — MCP Server   |   All three MCP primitives   |   stdio transport   |   server.registerTool / registerPrompt / resource" vertex="1">
          <mxGeometry height="26" width="1055" x="410" y="106" as="geometry" />
        </mxCell>
        <mxCell id="tl_outer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101820;strokeColor=#1a3050;strokeWidth=1;" value="" vertex="1">
