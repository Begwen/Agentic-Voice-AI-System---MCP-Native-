        <mxCell id="tl_head" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontColor=#5890c8;fontSize=11;fontStyle=1;strokeColor=none;fillColor=none;" value="TOOLS  (7)&lt;br&gt;Imperative actions — the LLM decides&lt;br&gt;when and how to invoke each one" vertex="1">
          <mxGeometry height="52" width="320" x="422" y="142" as="geometry" />
        </mxCell>
        <mxCell id="t1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#091420;strokeColor=#1a3050;fontSize=10;fontColor=#7aaed8;align=left;verticalAlign=top;" value="&lt;b&gt;list_voices&lt;/b&gt;&lt;br&gt;GET /v1/voices&lt;br&gt;All voices: IDs, names, categories, labels" vertex="1">
          <mxGeometry height="52" width="298" x="433" y="198" as="geometry" />
        </mxCell>
        <mxCell id="t2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#091420;strokeColor=#1a3050;fontSize=10;fontColor=#7aaed8;align=left;verticalAlign=top;" value="&lt;b&gt;get_voice&lt;/b&gt;&lt;br&gt;GET /v1/voices/{id}&lt;br&gt;Full details for a single voice by ID" vertex="1">
          <mxGeometry height="52" width="298" x="433" y="256" as="geometry" />
        </mxCell>
        <mxCell id="t3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#091420;strokeColor=#1a3050;fontSize=10;fontColor=#7aaed8;align=left;verticalAlign=top;" value="&lt;b&gt;list_models&lt;/b&gt;&lt;br&gt;GET /v1/models&lt;br&gt;TTS/STT models, capabilities, languages" vertex="1">
          <mxGeometry height="52" width="298" x="433" y="314" as="geometry" />
        </mxCell>
        <mxCell id="t4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#091420;strokeColor=#24487a;fontSize=10;fontColor=#8abce8;align=left;verticalAlign=top;" value="&lt;b&gt;text_to_speech&lt;/b&gt;&lt;br&gt;POST /v1/text-to-speech/{voice_id}&lt;br&gt;text  -&gt;  MP3 file saved to disk&lt;br&gt;Returns: &amp;quot;Audio saved to: /path.mp3&amp;quot;" vertex="1">
          <mxGeometry height="65" width="298" x="433" y="372" as="geometry" />
        </mxCell>
        <mxCell id="t5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#091420;strokeColor=#24487a;fontSize=10;fontColor=#8abce8;align=left;verticalAlign=top;" value="&lt;b&gt;speech_to_text&lt;/b&gt;&lt;br&gt;POST /v1/speech-to-text&lt;br&gt;Audio file path  -&gt;  transcript string&lt;br&gt;Model: scribe_v1  |  multipart/form-data" vertex="1">
          <mxGeometry height="65" width="298" x="433" y="443" as="geometry" />
        </mxCell>
        <mxCell id="t6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#091420;strokeColor=#1a3050;fontSize=10;fontColor=#7aaed8;align=left;verticalAlign=top;" value="&lt;b&gt;get_user_info&lt;/b&gt;&lt;br&gt;GET /v1/user&lt;br&gt;Account info, character quota and usage" vertex="1">
          <mxGeometry height="52" width="298" x="433" y="514" as="geometry" />
        </mxCell>
        <mxCell id="t7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#091420;strokeColor=#1a3050;fontSize=10;fontColor=#7aaed8;align=left;verticalAlign=top;" value="&lt;b&gt;get_history&lt;/b&gt;&lt;br&gt;GET /v1/history&lt;br&gt;Paginated TTS generation history" vertex="1">
          <mxGeometry height="52" width="298" x="433" y="572" as="geometry" />
        </mxCell>
        <mxCell id="t_impl" parent="1" style="text;html=1;align=center;fontColor=#28406a;fontSize=9;strokeColor=none;fillColor=none;" value="registerTool(name, { description, inputSchema }, handler)" vertex="1">
