        </mxCell>
        <mxCell id="t_impl2" parent="1" style="text;html=1;align=center;fontColor=#28406a;fontSize=9;strokeColor=none;fillColor=none;" value="Uses zod schemas for input validation" vertex="1">
          <mxGeometry height="20" width="320" x="422" y="654" as="geometry" />
        </mxCell>
        <mxCell id="pr_outer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0e1c12;strokeColor=#1e4030;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="596" width="398" x="756" y="138" as="geometry" />
        </mxCell>
        <mxCell id="pr_tag" parent="1" style="text;html=1;align=center;fontColor=#2e6040;fontSize=9;fontStyle=1;strokeColor=none;fillColor=none;" value="THE CORE DIFFERENTIATOR" vertex="1">
          <mxGeometry height="16" width="398" x="756" y="142" as="geometry" />
        </mxCell>
        <mxCell id="pr_head" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontColor=#60c880;fontSize=11;fontStyle=1;strokeColor=none;fillColor=none;" value="PROMPTS  (4)&lt;br&gt;Declarative behavioral context — define HOW&lt;br&gt;the agent thinks and speaks per session" vertex="1">
          <mxGeometry height="50" width="398" x="756" y="158" as="geometry" />
        </mxCell>
        <mxCell id="pr_why" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#081208;strokeColor=#1e4030;fontSize=10;fontColor=#60a070;align=left;verticalAlign=top;" value="Unlike tools (imperative: do X once), prompts are declarative. They inject a full conversation context that shapes the LLM for an entire session. Callbacks run at invocation time — they can call live APIs and embed the results in the instructions." vertex="1">
          <mxGeometry height="58" width="376" x="767" y="212" as="geometry" />
        </mxCell>
        <mxCell id="p1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#081208;strokeColor=#1e4030;fontSize=10;fontColor=#80cc98;align=left;verticalAlign=top;" value="&lt;b&gt;voice_agent_persona&lt;/b&gt;&lt;br&gt;Args: name, personality, [voice_style]&lt;br&gt;&lt;br&gt;Callback fetches the live voice list from&lt;br&gt;ElevenLabs at invocation time and embeds it&lt;br&gt;in a system message. Defines agent identity,&lt;br&gt;voice selection rules, TTS-every-reply mandate." vertex="1">
          <mxGeometry height="90" width="376" x="767" y="278" as="geometry" />
        </mxCell>
        <mxCell id="p2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#081208;strokeColor=#1e4030;fontSize=10;fontColor=#80cc98;align=left;verticalAlign=top;" value="&lt;b&gt;start_voice_session&lt;/b&gt;&lt;br&gt;Args: [topic], [language], [voice_id]&lt;br&gt;&lt;br&gt;Sets session-level behavioral rules: always&lt;br&gt;call text_to_speech, keep responses brief&lt;br&gt;and spoken-language natural, pick one voice&lt;br&gt;and use it consistently throughout." vertex="1">
          <mxGeometry height="90" width="376" x="767" y="374" as="geometry" />
        </mxCell>
        <mxCell id="p3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#081208;strokeColor=#1e4030;fontSize=10;fontColor=#80cc98;align=left;verticalAlign=top;" value="&lt;b&gt;find_voice_for_role&lt;/b&gt;&lt;br&gt;Args: role&lt;br&gt;&lt;br&gt;Instructs the LLM to call list_voices, reason&lt;br&gt;about labels vs the role, pick top 3 matches,&lt;br&gt;generate an audio sample for each, and return&lt;br&gt;a final recommended voice_id with justification." vertex="1">
          <mxGeometry height="90" width="376" x="767" y="470" as="geometry" />
        </mxCell>
        <mxCell id="p4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#081208;strokeColor=#1e4030;fontSize=10;fontColor=#80cc98;align=left;verticalAlign=top;" value="&lt;b&gt;voice_showcase&lt;/b&gt;&lt;br&gt;Args: phrase, [count]&lt;br&gt;&lt;br&gt;Renders the same phrase across N diverse&lt;br&gt;voices — different genders, accents, styles.&lt;br&gt;One MP3 per voice. Returns a summary table&lt;br&gt;of all voice IDs and their output file paths." vertex="1">
          <mxGeometry height="90" width="376" x="767" y="566" as="geometry" />
        </mxCell>
        <mxCell id="pr_impl" parent="1" style="text;html=1;align=center;fontColor=#1e4828;fontSize=9;strokeColor=none;fillColor=none;" value="registerPrompt(name, { description, argsSchema }, handler)" vertex="1">
          <mxGeometry height="30" width="398" x="756" y="662" as="geometry" />
        </mxCell>
        <mxCell id="pr_impl2" parent="1" style="text;html=1;align=center;fontColor=#1e4828;fontSize=9;strokeColor=none;fillColor=none;" value="Handler returns  { messages: [{ role, content }] }  injected into LLM history" vertex="1">
          <mxGeometry height="18" width="398" x="756" y="680" as="geometry" />
        </mxCell>
        <mxCell id="rs_outer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14102a;strokeColor=#2a1e55;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="596" width="285" x="1168" y="138" as="geometry" />
        </mxCell>
        <mxCell id="rs_head" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontColor=#9080c8;fontSize=11;fontStyle=1;strokeColor=none;fillColor=none;" value="RESOURCES  (2)&lt;br&gt;Live data context — the LLM reads&lt;br&gt;these as passive reference material" vertex="1">
          <mxGeometry height="52" width="285" x="1168" y="142" as="geometry" />
        </mxCell>
        <mxCell id="rs_why" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0c0820;strokeColor=#2a1e55;fontSize=10;fontColor=#7060a8;align=left;verticalAlign=top;" value="Resources expose live API data the LLM reads as context without a tool call. Discoverable in MCP clients that support resource subscriptions (Claude Desktop, Claude Code). Fetched fresh on every read request." vertex="1">
          <mxGeometry height="78" width="265" x="1178" y="198" as="geometry" />
        </mxCell>
        <mxCell id="r1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0c0820;strokeColor=#2a1e55;fontSize=10;fontColor=#a898d8;align=left;verticalAlign=top;" value="&lt;b&gt;elevenlabs://voices&lt;/b&gt;&lt;br&gt;GET /v1/voices&lt;br&gt;&lt;br&gt;Live list of all voices: IDs,&lt;br&gt;categories, labels, preview URLs.&lt;br&gt;&lt;br&gt;Read before calling&lt;br&gt;text_to_speech to choose&lt;br&gt;the optimal voice." vertex="1">
          <mxGeometry height="150" width="265" x="1178" y="284" as="geometry" />
        </mxCell>
        <mxCell id="r2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0c0820;strokeColor=#2a1e55;fontSize=10;fontColor=#a898d8;align=left;verticalAlign=top;" value="&lt;b&gt;elevenlabs://models&lt;/b&gt;&lt;br&gt;GET /v1/models&lt;br&gt;&lt;br&gt;All TTS and STT models with&lt;br&gt;capabilities and supported&lt;br&gt;languages.&lt;br&gt;&lt;br&gt;Read to pick the best model&lt;br&gt;for the use case or language." vertex="1">
          <mxGeometry height="150" width="265" x="1178" y="444" as="geometry" />
        </mxCell>
        <mxCell id="rs_impl" parent="1" style="text;html=1;align=center;fontColor=#2a1e50;fontSize=9;strokeColor=none;fillColor=none;" value="resource(name, uri, { description, mimeType }, handler)" vertex="1">
          <mxGeometry height="28" width="285" x="1168" y="648" as="geometry" />
        </mxCell>
        <mxCell id="rs_impl2" parent="1" style="text;html=1;align=center;fontColor=#2a1e50;fontSize=9;strokeColor=none;fillColor=none;" value="handler returns  { contents: [{ uri, mimeType, text }] }" vertex="1">
          <mxGeometry height="18" width="285" x="1168" y="668" as="geometry" />
