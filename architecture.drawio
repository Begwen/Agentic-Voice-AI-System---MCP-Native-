        <mxCell id="arr_mcp_c" edge="1" parent="1" source="mcp_outer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#383868;strokeWidth=1;fontColor=#5860a0;fontSize=9;exitX=0;exitY=0.72;exitDx=0;exitDy=0;entryX=1;entryY=0.72;entryDx=0;entryDy=0;" target="c_outer" value="tool results">
