        </mxCell>
        <mxCell id="llm_head" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontColor=#9090d0;fontSize=13;fontStyle=1;strokeColor=none;fillColor=none;" value="LLM API" vertex="1">
          <mxGeometry height="26" width="400" x="1480" y="106" as="geometry" />
        </mxCell>
        <mxCell id="llm_body" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0e0e22;strokeColor=#282870;fontSize=10;fontColor=#8888c8;align=left;verticalAlign=top;" value="&lt;b&gt;Anthropic Claude&lt;/b&gt;&lt;br&gt;Model: claude-sonnet-4-20250514&lt;br&gt;Tool format: tool_use content blocks&lt;br&gt;&lt;br&gt;&lt;b&gt;OpenAI GPT&lt;/b&gt;&lt;br&gt;Model: gpt-4o&lt;br&gt;Tool format: function calling (tool_calls)&lt;br&gt;&lt;br&gt;client.ts converts MCP tool definitions to&lt;br&gt;each provider&#39;s native format on the fly.&lt;br&gt;&lt;br&gt;&lt;b&gt;VOICE_SYSTEM override  (voice mode)&lt;/b&gt;&lt;br&gt;Replaces default system message. Forces LLM&lt;br&gt;to call text_to_speech on every response.&lt;br&gt;Keeps replies to 2-3 spoken sentences." vertex="1">
          <mxGeometry height="264" width="380" x="1490" y="136" as="geometry" />
        </mxCell>
        <mxCell id="el_outer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e1015;strokeColor=#482030;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="310" width="400" x="1480" y="430" as="geometry" />
        </mxCell>
        <mxCell id="el_head" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontColor=#c09898;fontSize=13;fontStyle=1;strokeColor=none;fillColor=none;" value="ElevenLabs REST API" vertex="1">
          <mxGeometry height="26" width="400" x="1480" y="436" as="geometry" />
        </mxCell>
        <mxCell id="el_body" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#140c10;strokeColor=#482030;fontSize=10;fontColor=#b08888;align=left;verticalAlign=top;" value="Base URL: api.elevenlabs.io/v1&lt;br&gt;Auth header: xi-api-key&lt;br&gt;&lt;br&gt;GET   /voices             list_voices tool + voices resource&lt;br&gt;GET   /voices/{id}        get_voice tool&lt;br&gt;GET   /models             list_models tool + models resource&lt;br&gt;&lt;br&gt;POST  /text-to-speech     text_to_speech tool&lt;br&gt;POST  /speech-to-text     speech_to_text tool  (scribe_v1)&lt;br&gt;      Content: multipart/form-data&lt;br&gt;&lt;br&gt;GET   /user               get_user_info tool&lt;br&gt;GET   /history            get_history tool&lt;br&gt;&lt;br&gt;Wrapped in: elevenlabs-client.ts" vertex="1">
          <mxGeometry height="264" width="380" x="1490" y="466" as="geometry" />
        </mxCell>
