        <mxCell id="arr_c_mcp" edge="1" parent="1" source="c_outer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#383868;strokeWidth=1;fontColor=#5860a0;fontSize=9;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" target="mcp_outer" value="tool calls (JSON-RPC)">
