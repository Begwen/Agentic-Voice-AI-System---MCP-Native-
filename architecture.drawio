        </mxCell>
        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontColor=#d0d4f0;fontSize=22;fontStyle=1;strokeColor=none;fillColor=none;" value="ElevenLabs Voice-to-Voice Agent" vertex="1">
          <mxGeometry height="42" width="1860" x="20" y="16" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontColor=#6870a0;fontSize=12;strokeColor=none;fillColor=none;" value="A prompt-centric MCP implementation — Tools (actions) + Prompts (behavioral context) + Resources (live data) — powering a real-time voice-to-voice conversation agent" vertex="1">
          <mxGeometry height="26" width="1860" x="20" y="60" as="geometry" />
        </mxCell>
        <mxCell id="div1" edge="1" parent="1" style="endArrow=none;html=1;strokeColor=#22244a;strokeWidth=1;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="20" y="93" as="sourcePoint" />
